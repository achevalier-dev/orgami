#!/usr/bin/env bash
# orgami — a map of an organization's repositories, its digests, and its memory.
# One directory per organization under ~/.orgami. No daemon, no database.

set -euo pipefail

# Resolve this file through any symlinks before anything else, without GNU
# readlink -f, which macOS does not have.
_self=${BASH_SOURCE[0]}
while [[ -L $_self ]]; do
  _link=$(readlink "$_self")
  if [[ $_link == /* ]]; then _self=$_link; else _self=$(dirname "$_self")/$_link; fi
done
ORGAMI_BIN=$(cd -- "$(dirname -- "$_self")" && pwd)/$(basename "$_self")
ROOT=$(cd -- "$(dirname -- "$ORGAMI_BIN")/.." && pwd)

source "$ROOT/lib/common.sh"

need jq

usage() {
  cat <<'EOF'
orgami — your organization's map, digests and memory, in your agent's context

  orgami                    the menu
  orgami init               map your organization
  orgami view               the map, the repos, the notes, the recaps
  orgami note "…"           record what nobody should rediscover
  orgami context [repo]     what an agent is handed before it edits
  orgami daily              what the org did today
  orgami report             this week's recap
  orgami scan               rebuild the map from every repo
  orgami live               what is actually deployed, from the providers
  orgami publish            commit the map and the reports to the docs repo
  orgami schedule           run it on a timer, daily and weekly

  orgami help --all         every command, including the rare ones
EOF
}

usage_all() {
  cat <<'EOF'
orgami — your organization's map, digests and memory, in your agent's context

Setup
  orgami init                           map an organization, step by step
  orgami init <name> --org <github-org> [--docs-repo <url>] [--docs-path <dir>]
  orgami join                           pick up an org a colleague already mapped
  orgami join <name> --repo <url>       the same, without the questions
  orgami schedule [--daily] [--off]     run on systemd, launchd or cron
  orgami claude-project [<url>]         the Claude project that reads the docs repo
  orgami version                        which version is installed

The map
  orgami scan [--only <repo>] [--depth N]
                                        rebuild the map from every repo
  orgami doc [--narrate]                render ARCHITECTURE.md and the repo cards
  orgami view                           browse the map in the terminal
  orgami query <repo|host|tool|service> print one node and its edges
  orgami card <repo>                    the repo's page: stack, commands, links
  orgami runbook [<repo>]               how to run, ship and unbreak it
  orgami coupling                       which repos keep changing together
  orgami live [--provider vercel,fly,aws] [--json]
                                        what is deployed right now, per provider

Digests
  orgami daily [--date D | --yesterday] [--stats-only]
                                        what the org did in one day
  orgami pull [--last N] [--since D --until D]
                                        cache merged PRs for a week
  orgami report [--week YYYY-Www] [--model M] [--stats-only]
                                        write the weekly recap
  orgami latest [--week W] [--raw]      read the newest recap
  orgami publish [--dry-run] [-y]       commit reports and map to the docs repo
  orgami weekly                         pull, report, scan, doc, publish

Team memory
  orgami note ["what you learned"]      record it for the whole team
  orgami notes [--repo R] [--tag T] [q] what the team has recorded
  orgami autonote [publish|drafts]      send notes out as written, or hold them
  orgami drafts                         keep or drop notes written for you
  orgami sync [--pr]                    exchange notes through the docs repo
  orgami sync --pull [--max-age MIN]    take what the team wrote, push nothing
  orgami autosync                       reconcile everything: pull, push, review, merge
  orgami review [--auto [--merge]]      read and merge the notes waiting for review
  orgami review --install-check         gate the docs repo with a CI screen
  orgami screen <file>...               screen note files — what CI runs
  orgami notes --check | --rejected | --pending
  orgami stale [days]                   notes old enough to need a second look
  orgami prune --superseded | --id <id> archive notes that have had their day

Agents
  orgami context [repo]                 everything an agent needs before editing
  orgami agents [--cursor] [--all]      write the context into AGENTS.md / rules
  orgami agents --refresh [--workspace P]  rewrite every block under a workspace
  orgami agents --cursor-hook [--user]  Cursor injects it at every session start
  orgami agents --git-hook              refresh the block on merge and checkout
  orgami mcp                            serve the map over MCP, for any client
  orgami mcp --config <client>          the config snippet for cursor, opencode, …

More than one organization
  orgami use <name>                     make it the default
  orgami list                           organizations configured here
  ORGAMI_COMPANY=<name> orgami …        one command against another one
EOF
}

cmd=${1:-}
[[ $# -gt 0 ]] && shift

# Bare `orgami` opens the menu when there is a terminal to draw it on.
if [[ -z $cmd ]]; then
  if [[ -t 0 && -t 1 ]]; then cmd=menu; else cmd=help; fi
fi

# Bare `orgami init` walks you through it instead of demanding flags.
if [[ $cmd == init && $# -eq 0 && -t 0 && -t 1 ]]; then cmd=setup; fi

case $cmd in
  claude-project)
    source "$ROOT/lib/init.sh"
    cmd_claude_project "$@"
    ;;
  init | use | list)
    source "$ROOT/lib/init.sh"
    "cmd_$cmd" "$@"
    ;;
  menu | setup)
    source "$ROOT/lib/init.sh"
    source "$ROOT/lib/style.sh"
    source "$ROOT/lib/tui.sh"
    source "$ROOT/lib/ui.sh"
    "cmd_$cmd" "$@"
    ;;
  pull)
    source "$ROOT/lib/pull.sh"
    cmd_pull "$@"
    ;;
  latest | read)
    source "$ROOT/lib/report.sh"
    cmd_latest "$@"
    ;;
  report)
    source "$ROOT/lib/report.sh"
    cmd_report "$@"
    ;;
  daily)
    source "$ROOT/lib/pull.sh"
    source "$ROOT/lib/daily.sh"
    cmd_daily "$@"
    ;;
  scan)
    source "$ROOT/lib/scan.sh"
    source "$ROOT/lib/profile.sh"
    cmd_scan "$@"
    ;;
  doc)
    source "$ROOT/lib/doc.sh"
    cmd_doc "$@"
    ;;
  view | query | show | open)
    source "$ROOT/lib/style.sh"
    source "$ROOT/lib/tui.sh"
    source "$ROOT/lib/view.sh"
    "cmd_$cmd" "$@"
    ;;
  _tui)
    source "$ROOT/lib/style.sh"
    source "$ROOT/lib/tui.sh"
    cmd__tui "$@"
    ;;
  coupling)
    source "$ROOT/lib/coupling.sh"
    cmd_coupling "$@"
    ;;
  live)
    source "$ROOT/lib/live.sh"
    cmd_live "$@"
    ;;
  note-auto)
    source "$ROOT/lib/notes.sh"
    source "$ROOT/lib/autonote.sh"
    cmd_note_auto "$@"
    ;;
  autonote)
    source "$ROOT/lib/notes.sh"
    source "$ROOT/lib/autonote.sh"
    cmd_autonote "$@"
    ;;
  drafts)
    source "$ROOT/lib/notes.sh"
    source "$ROOT/lib/autonote.sh"
    cmd_drafts "$@"
    ;;
  note | notes | sync | join | prune | stale | review | screen | autosync)
    source "$ROOT/lib/notes.sh"
    "cmd_$cmd" "$@"
    ;;
  mcp)
    if [[ ${1:-} == --config ]]; then
      source "$ROOT/lib/agents.sh"
      cmd_mcp_config "${2:-}"
      exit $?
    fi
    need python3
    exec python3 "$ROOT/lib/mcp.py" "$@"
    ;;
  schedule)
    source "$ROOT/lib/schedule.sh"
    cmd_schedule "$@"
    ;;
  agents)
    source "$ROOT/lib/agents.sh"
    cmd_agents "$@"
    ;;
  runbook)
    source "$ROOT/lib/runbook.sh"
    cmd_runbook "$@"
    ;;
  card | context | brief)
    source "$ROOT/lib/card.sh"
    "cmd_$cmd" "$@"
    ;;
  publish)
    source "$ROOT/lib/publish.sh"
    cmd_publish "$@"
    ;;
  weekly)
    source "$ROOT/lib/pull.sh"
    source "$ROOT/lib/report.sh"
    source "$ROOT/lib/scan.sh"
    source "$ROOT/lib/profile.sh"
    source "$ROOT/lib/doc.sh"
    source "$ROOT/lib/coupling.sh"
    source "$ROOT/lib/notes.sh"
    source "$ROOT/lib/publish.sh"
    cmd_weekly "$@"
    ;;
  help | -h | --help)
    if [[ ${1:-} == --all || ${1:-} == -a ]]; then usage_all; else usage; fi
    ;;
  version | -v | --version)
    echo "orgami $(jq -r '.version // "unknown"' "$ROOT/manifest.json")"
    ;;
  *)
    usage >&2
    die "unknown command: $cmd"
    ;;
esac
