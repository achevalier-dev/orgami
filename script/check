#!/usr/bin/env bash
# Everything CI runs, runnable before you push. No arguments: both passes.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

SCRIPTS=(bin/orgami install.sh script/check)
while IFS= read -r f; do SCRIPTS+=("$f"); done < <(
  find lib hooks -name '*.sh' -type f | sort
)

syntax() {
  local f bad=0
  for f in "${SCRIPTS[@]}"; do
    bash -n "$f" || { echo "syntax error: $f" >&2; bad=1; }
  done
  [[ $bad == 0 ]] && echo "bash -n: ${#SCRIPTS[@]} scripts ok"
  return $bad
}

lint() {
  command -v shellcheck >/dev/null || {
    echo "shellcheck not installed — skipping (CI will run it)" >&2
    return 0
  }
  shellcheck --severity=warning --external-sources "${SCRIPTS[@]}" &&
    echo "shellcheck: clean at warning severity"
}

# The whole deterministic half of the weekly report, on a fixture week. No
# GitHub token, no org, no model.
stats() {
  local out
  out=$(jq -f lib/stats.jq test/fixtures/week.json)
  local merged reviewless
  merged=$(jq -r .merged <<<"$out")
  reviewless=$(jq -r .merged_without_review <<<"$out")
  [[ $merged == 3 ]] || { echo "expected 3 merged, got $merged" >&2; return 1; }
  [[ $reviewless == 2 ]] || { echo "expected 2 unreviewed, got $reviewless" >&2; return 1; }
  echo "stats.jq: fixture week reads back correctly"
}

case ${1-} in
  --syntax-only) syntax ;;
  --lint-only) lint ;;
  --stats) stats ;;
  "") syntax && lint && stats ;;
  *)
    echo "usage: script/check [--syntax-only | --lint-only | --stats]" >&2
    exit 2
    ;;
esac
